{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ai Usage Dock",
  "version": "0.1.1",
  "identifier": "local.codex.ai-usage-dock",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ai Usage Dock",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Track local AI usage limits",
    "longDescription": "A local-only Windows tray app for tracking remaining AI usage limits across providers."
  }
}
