{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Usage Tray",
  "version": "0.1.0",
  "identifier": "local.codex.llm-usage-tray",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Usage Tray",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Track local LLM usage limits",
    "longDescription": "A local-only Windows tray app for manually tracking remaining usage limits across LLM tools."
  }
}
